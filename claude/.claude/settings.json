{
    "model": "opus",
    "permissions": {
        "allow": [
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git stash*)",
            "Bash(brew list*)",
            "Bash(brew info*)",
            "Bash(pytest *)",
            "WebSearch"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push --force*)",
            "Bash(git reset --hard*)"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh",
        "padding": 2
    }
}
