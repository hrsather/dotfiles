{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(rg:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(sort:*)",
      "Bash(which *)",
      "Bash(wc *)",
      "Bash(brew list*)",
      "Bash(brew info*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(az *)",
      "Bash(openspec *)",
      "Bash(jira *)",
      "WebFetch(domain:github.com)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(git clean -f*)"
    ]
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen"
}
