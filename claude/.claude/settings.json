{
    "model": "opus",
    "permissions": {
        "allow": [
            "Read",
            "Grep",
            "Glob",
            "WebSearch",
            "WebFetch(domain:github.com)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git remote*)",
            "Bash(git show*)",
            "Bash(brew list*)",
            "Bash(brew info*)",
            "Bash(pytest *)",
            "Bash(jira issue comment add:*)",
            "Bash(jira issue move:*)",
            "Bash(jira issue list:*)",
            "Bash(jira issue create:*)",
            "Bash(jira issue view:*)",
            "Bash(ls:*)",
            "Bash(sort:*)",
            "Bash(which *)",
            "Bash(wc *)",
            "Bash(gh pr view*)",
            "Bash(gh issue view*)"
        ],
        "deny": [
            "Bash(rm -rf *)",
            "Bash(git push --force*)",
            "Bash(git reset --hard*)"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh",
        "padding": 2
    }
}
