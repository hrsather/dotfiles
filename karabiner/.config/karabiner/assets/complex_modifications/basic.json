{
  "title": "Improve Mac",
  "rules": [
    {
      "description": "Caps lock to escape",
      "manipulators": [
        {
          "from": {
            "key_code": "caps_lock",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "escape",
              "modifiers": []
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Swap control and command",
      "manipulators": [
        {
          "from": {
            "key_code": "left_control",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_command",
              "modifiers": []
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "left_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_control",
              "modifiers": []
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Swap semicolon and underscore",
      "manipulators": [
        {
          "from": {
            "key_code": "semicolon"
          },
          "to": [
            {
              "key_code": "hyphen",
              "modifiers": ["left_shift"]
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "hyphen",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": [
            {
              "key_code": "semicolon",
              "modifiers": []
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Command-arrow to move browser tabs",
      "manipulators": [
        {
          "from": {
            "key_code": "left_arrow",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": ["left_command", "left_alt"]
            }
          ],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "right_arrow",
            "modifiers": { "mandatory": ["left_control"] }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": ["left_command", "left_alt"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
