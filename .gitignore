btop/.config/btop/btop.log
nvim/.config/nvim/lazy-lock.json
.claude/settings.local.json

# Override global gitignore — this repo manages claude config
!**/CLAUDE.md
!**/.claude/
!**/.claude/**

# OpenSpec-managed (regenerated automatically)
.claude/commands/opsx/
.claude/skills/openspec-*

# AI skills symlinked from external repo (machine-local, not tracked)
claude/.claude/skills/*
!claude/.claude/skills/babysit
!claude/.claude/skills/babysit/**


# Credentials
*.pem
*.key
*.crt
*.env
**/credentials*
**/secrets*
**/*token*
**/client.yml

# Cache
**/.cache/
**/cache/
